#!/usr/bin/env python
"""
Build the fractal_native GDExtension.

Pre-requisites (built by build/setup_<platform>.sh):
  build/godot-cpp/bin/libgodot-cpp.<plat>.<target>.<arch>.a
  build/sentry-native/build_<plat>_<arch>/libsentry.a
  build/sentry-native/build_<plat>_<arch>/crashpad_build/.../libcrashpad_*.a
  build/sentry-native/include/sentry.h

Run:
  scons platform=macos arch=arm64 target=template_release
"""

import os

env = SConscript("build/godot-cpp/SConstruct")

# ─── Version ──────────────────────────────────────────────────────────────
# Read ../../VERSION and generate a gitignored header rather than passing
# -DFRACTAL_SDK_VERSION=... on the command line — MSVC and gcc quote string
# defines differently, and this sidesteps that entirely.

version_file = os.path.join(Dir("#").abspath, "..", "..", "VERSION")
with open(version_file) as f:
    sdk_version = f.read().strip()

gen_dir = "src/gen"
os.makedirs(gen_dir, exist_ok=True)
with open(os.path.join(gen_dir, "fractal_version.gen.h"), "w") as f:
    f.write("// Auto-generated by SConstruct from ../../VERSION. Do not edit.\n")
    f.write("#pragma once\n")
    f.write('#define FRACTAL_SDK_VERSION "{}"\n'.format(sdk_version))

# ─── Paths ────────────────────────────────────────────────────────────────

build_root = "build/sentry-native"
build_dir  = "{}/build_{}_{}".format(build_root, env["platform"], env["arch"])
crashpad   = "{}/crashpad_build".format(build_dir)

env.Append(CPPPATH=["src/", "{}/include".format(build_root)])
env.Append(LIBPATH=[
    build_dir,
    "{}/client".format(crashpad),
    "{}/util".format(crashpad),
    "{}/snapshot".format(crashpad),
    "{}/minidump".format(crashpad),
    "{}/handler".format(crashpad),
    "{}/tools".format(crashpad),
    "{}/third_party/mini_chromium".format(crashpad),
    "{}/third_party/mpack".format(crashpad),
])
# MSVC drops static libs into a Release/ subdirectory rather than the
# build-config root; add those paths in addition to the Unix-style ones above.
if env["platform"] == "windows":
    env.Append(LIBPATH=[
        "{}/Release".format(build_dir),
        "{}/client/Release".format(crashpad),
        "{}/util/Release".format(crashpad),
        "{}/snapshot/Release".format(crashpad),
        "{}/minidump/Release".format(crashpad),
        "{}/handler/Release".format(crashpad),
        "{}/tools/Release".format(crashpad),
        "{}/third_party/mini_chromium/Release".format(crashpad),
        "{}/third_party/mpack/Release".format(crashpad),
        "{}/third_party/zlib/Release".format(crashpad),
    ])

# Order matters: clients depend on util/snapshot which depend on
# mini_chromium. Static link the lot, end up with one self-contained lib.
common_libs = [
    "sentry",
    "crashpad_client",
    "crashpad_minidump",
    "crashpad_snapshot",
    "crashpad_util",
    "crashpad_mpack",
    "mini_chromium",
]
env.Append(LIBS=common_libs)

if env["platform"] == "macos":
    env.Append(LIBS=["z", "objc"])
    env.Append(LINKFLAGS=[
        "-framework", "Foundation",
        "-framework", "Security",
        "-framework", "AppKit",
        "-framework", "IOKit",
        "-framework", "CoreServices",
        "-framework", "CoreFoundation",
        "-framework", "CoreGraphics",
        "-framework", "CoreText",
        "-framework", "ApplicationServices",
        "-framework", "Carbon",
        "-framework", "SystemConfiguration",
        "-framework", "ImageIO",
        "-framework", "QuartzCore",
        "-framework", "Metal",
        "-framework", "OpenGL",
        "-lbsm",
    ])
elif env["platform"] == "linux":
    # Crashpad references _Ux86_64_getcontext as a weak symbol; --as-needed drops
    # libunwind-x86_64 from NEEDED. Force it in with --no-as-needed then restore.
    env.Append(LINKFLAGS=["-Wl,--no-as-needed,-lunwind-x86_64,--as-needed"])
    env.Append(LIBS=["z", "pthread", "dl", "rt", "curl"])
elif env["platform"] == "windows":
    # sentry.h defaults to __declspec(dllimport) under MSVC unless this is set.
    env.Append(CPPDEFINES=["SENTRY_BUILD_STATIC"])
    env.Append(LIBS=[
        "crashpad_zlib", "winhttp", "advapi32", "shell32", "user32",
        "version", "dbghelp", "ws2_32", "rpcrt4", "shlwapi",
        "synchronization",
    ])

# ─── Output ───────────────────────────────────────────────────────────────

src_files = ["src/register_types.cpp", "src/fractal_native.cpp"]

out_dir = "bin/{}-{}".format(env["platform"], env["arch"])

if env["platform"] == "macos":
    lib_name = "libfractal_native.dylib"
elif env["platform"] == "linux":
    lib_name = "libfractal_native.so"
elif env["platform"] == "windows":
    lib_name = "fractal_native.dll"
else:
    lib_name = "fractal_native"

target = env.SharedLibrary(
    target=os.path.join(out_dir, lib_name),
    source=src_files,
)

Default(target)
